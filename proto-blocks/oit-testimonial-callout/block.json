{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "proto-blocks/oit-testimonial-callout",
  "version": "1.0.0",
  "title": "OIT Testimonial Callout",
  "category": "optimizedit",
  "icon": "format-quote",
  "description": "Two-column conversion callout on the brand black->red gradient card: numbered get-started steps + CTA on the left, framed testimonial quote with attribution on the right. Scroll-triggered staged reveal.",
  "keywords": ["testimonial", "callout", "steps", "process", "quote", "oit"],
  "supports": {
    "html": false,
    "anchor": true,
    "customClassName": true,
    "align": ["wide", "full"]
  },
  "protoBlocks": {
    "version": "1.0",
    "useTailwind": true,
    "template": "template.php",
    "fields": {
      "headline": {
        "type": "wysiwyg",
        "label": "Headline"
      },
      "steps": {
        "type": "repeater",
        "label": "Steps",
        "min": 1,
        "max": 8,
        "itemLabel": "text",
        "collapsible": true,
        "fields": {
          "text": {
            "type": "text",
            "label": "Step Text"
          }
        }
      },
      "cta": {
        "type": "link",
        "label": "CTA Button",
        "tagName": "a"
      },
      "quote": {
        "type": "wysiwyg",
        "label": "Testimonial Quote"
      },
      "attribution": {
        "type": "text",
        "label": "Attribution (Name, Position, Company)",
        "tagName": "p"
      }
    },
    "controls": {
      "showSteps": {
        "type": "toggle",
        "label": "Show steps + CTA column",
        "default": true
      },
      "showTestimonial": {
        "type": "toggle",
        "label": "Show testimonial column",
        "default": true
      }
    }
  }
}
