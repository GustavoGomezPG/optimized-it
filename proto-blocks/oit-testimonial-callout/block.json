{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "proto-blocks/oit-testimonial-callout",
  "version": "1.0.0",
  "title": "OIT Testimonial Callout",
  "category": "optimizedit",
  "icon": "format-quote",
  "description": "Two-column conversion callout on the brand black->red gradient card: numbered get-started steps + CTA on the left, framed testimonial quote with attribution on the right. Scroll-triggered staged reveal.",
  "keywords": ["testimonial", "callout", "steps", "process", "quote", "oit"],
  "supports": {
    "html": false,
    "anchor": true,
    "customClassName": true,
    "align": ["wide", "full"]
  },
  "protoBlocks": {
    "version": "1.0",
    "useTailwind": true,
    "template": "template.php",
    "fields": {
      "headline": {
        "type": "wysiwyg",
        "label": "Headline"
      },
      "steps": {
        "type": "repeater",
        "label": "Steps",
        "min": 1,
        "max": 8,
        "itemLabel": "text",
        "collapsible": true,
        "fields": {
          "text": {
            "type": "text",
            "label": "Step Text"
          }
        }
      },
      "cta": {
        "type": "link",
        "label": "CTA Button",
        "tagName": "a"
      },
      "quote": {
        "type": "wysiwyg",
        "label": "Testimonial Quote"
      },
      "attribution": {
        "type": "text",
        "label": "Attribution (Name, Position, Company)",
        "tagName": "p"
      }
    },
    "controls": {
      "showSteps": {
        "type": "toggle",
        "label": "Show steps + CTA column",
        "default": true
      },
      "showTestimonial": {
        "type": "toggle",
        "label": "Show testimonial column",
        "default": true
      },
      "source": {
        "type": "select",
        "label": "Testimonial Source",
        "default": "manual",
        "options": [
          { "key": "manual", "label": "Manual (single quote)" },
          { "key": "smileback", "label": "SmileBack (auto-rotating)" }
        ],
        "help": "Manual uses the Quote/Attribution above. SmileBack pulls live reviews and rotates through them in the quote frame."
      },
      "maxReviews": {
        "type": "number",
        "label": "Max SmileBack reviews",
        "default": 12,
        "min": 1,
        "max": 30,
        "help": "How many SmileBack reviews to rotate through (after filtering)."
      },
      "autoplaySeconds": {
        "type": "number",
        "label": "Slide duration (seconds)",
        "default": 6,
        "min": 0,
        "max": 30,
        "help": "How long each review shows before auto-advancing. Set to 0 to disable autoplay (arrows/dots only)."
      },
      "order": {
        "type": "select",
        "label": "Review order",
        "default": "newest",
        "options": [
          { "key": "newest", "label": "Newest first" },
          { "key": "random", "label": "Random" },
          { "key": "default", "label": "As published (feed order)" }
        ]
      },
      "requireCompany": {
        "type": "toggle",
        "label": "Only reviews with a company",
        "default": false,
        "help": "Skip reviews that don't include a company name."
      },
      "minLength": {
        "type": "number",
        "label": "Minimum review length",
        "default": 0,
        "min": 0,
        "max": 500,
        "help": "Hide reviews shorter than this many characters (0 = no minimum)."
      }
    }
  }
}
