{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "proto-blocks/oit-blog-archive",
  "version": "1.0.0",
  "title": "OIT Blog Archive",
  "category": "optimizedit",
  "icon": "grid-view",
  "description": "Paginated archive of blog posts as a 3-column grid of cards (image, date, category tags, title). Includes a 'Filter by topic' (category) dropdown and a 'Sort by' dropdown, both server-driven via the URL, plus numbered pagination. Drop on a Blog page.",
  "keywords": ["blog", "archive", "posts", "grid", "filter", "sort", "pagination", "oit"],
  "supports": {
    "html": false,
    "anchor": true,
    "customClassName": true,
    "align": ["wide", "full"]
  },
  "protoBlocks": {
    "version": "1.0",
    "useTailwind": true,
    "template": "template.php",
    "fields": {
      "heading": {
        "type": "text",
        "label": "Section heading",
        "tagName": "h2"
      }
    },
    "controls": {
      "perPage": {
        "type": "number",
        "label": "Posts per page",
        "min": 1,
        "max": 24,
        "default": 9,
        "help": "How many posts to show per page."
      },
      "showFilter": {
        "type": "toggle",
        "label": "Show 'Filter by topic'",
        "default": true
      },
      "showSort": {
        "type": "toggle",
        "label": "Show 'Sort by'",
        "default": true
      }
    }
  }
}
