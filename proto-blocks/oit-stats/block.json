{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "proto-blocks/oit-stats",
  "version": "1.0.0",
  "title": "OIT Stats",
  "category": "optimizedit",
  "icon": "chart-bar",
  "description": "Intro headline + body, followed by a row of large brand-red stat numbers that roll up on scroll, each with a supporting paragraph.",
  "keywords": ["stats", "numbers", "kpi", "counter", "oit"],
  "supports": {
    "html": false,
    "anchor": true,
    "customClassName": true,
    "align": ["wide", "full"]
  },
  "protoBlocks": {
    "version": "1.0",
    "useTailwind": true,
    "template": "template.php",
    "fields": {
      "headline": {
        "type": "text",
        "label": "Headline",
        "tagName": "h2"
      },
      "body": {
        "type": "wysiwyg",
        "label": "Body"
      },
      "stats": {
        "type": "repeater",
        "label": "Stats",
        "min": 1,
        "max": 6,
        "itemLabel": "value",
        "collapsible": true,
        "fields": {
          "value": {
            "type": "text",
            "label": "Value (numeric, e.g. 99.5)"
          },
          "suffix": {
            "type": "text",
            "label": "Suffix (e.g. % or  SECONDS)"
          },
          "description": {
            "type": "text",
            "label": "Description"
          }
        }
      }
    },
    "controls": {}
  }
}
